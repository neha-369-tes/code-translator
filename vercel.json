{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/**"]
      }
    }
  ],
  "routes": [
    { 
      "src": "/api/(.*)", 
      "dest": "/api/index.js" 
    },
    { 
      "src": "/assets/(.*)", 
      "dest": "/dist/public/assets/$1" 
    },
    { 
      "src": "/(.*\\.(js|css|ico|png|jpg|jpeg|svg|webp|json|woff|woff2|ttf|eot))", 
      "dest": "/dist/public/$1" 
    },
    { 
      "src": "/(.*)", 
      "dest": "/dist/public/index.html" 
    }
  ],
  "env": {
    "GEMINI_API_KEY": "AIzaSyB2ijqZuPfKhbQQ2boJr7NZ8ssrE4_takI",
    "NODE_ENV": "production"
  }
}
